#!/bin/sh

FILES=$(git diff --cached --name-only --diff-filter=ACMR)

for FILE in $FILES; do
    if echo "$FILE" | grep -qE "^(Saved|Intermediate|Binaries|DerivedDataCache|\.vs)[/\\]"; then
        echo "ACCESS DENIED: Forbidden folder file: $FILE"
        exit 1
    fi

    if [ -f "$FILE" ]; then
        SIZE=$(wc -c < "$FILE" | tr -d ' ')
        if [ "$SIZE" -gt 52428800 ]; then
            ATTR=$(git check-attr filter -- "$FILE" | awk '{print $NF}')
            if [ "$ATTR" != "lfs" ]; then
                echo "CONTRABAND: File is >50MB and not tracked by LFS: $FILE"
                exit 1
            fi
        fi
    fi
done

echo "Commit approved. Glory to Arstotzka!"
exit 0